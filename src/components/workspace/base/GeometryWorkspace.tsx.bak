"use client";

import React, { useState } from "react";
import { BaseWorkspace } from "@/components/workspace/shared/BaseWorkspace";
import { Tabs, TabsContent, TabsList, TabsTrigger } from "@/components/ui/tabs";
import { ScrollArea } from "@/components/ui/scroll-area";
import { Shapes, Circle, Square, Triangle, Maximize2, Plus, Trash2, Download, Wand2, Sparkles } from "lucide-react";
import { Button } from "@/components/ui/button";
import { useLogoUpload } from "@/lib/hooks/useLogoUpload";
import { WorkspaceAIGenerator } from "@/components/workspace/shared/WorkspaceAIGenerator";
import { toast } from "sonner";

type GenerationMode = "questions" | "auto";

interface GeometryItem {
    id: string;
    url: string;
    name: string;
    type: "circle" | "square" | "triangle" | "rectangle" | "polygon";
    color: string;
}

const GeometryGallery = ({
    items,
    onAdd,
    onDelete,
    brandId,
    generatedImage
}: {
    items: GeometryItem[],
    onAdd: (item: GeometryItem) => void,
    onDelete: (id: string) => void,
    brandId: string
    generatedImage?: string | null
}) => {
    const { uploadLogo } = useLogoUpload(brandId);

    const handleUpload = async (file: File, type: GeometryItem['type']) => {
        const url = await uploadLogo(file, `geometry/${type}/${Date.now()}`);
        if (url) {
            onAdd({
                id: Date.now().toString(),
                url,
                name: file.name.replace(/\.[^/.]+$/, ""),
                type,
                color: "#000000"
            });
        }
    };

    return (
        <div className="p-6 space-y-8">
            <div className="flex items-center justify-between mb-6">
                <h3 className="text-lg font-medium text-white">Galería de Formas Geométricas</h3>
                <div className="flex gap-3">
                    <Button
                        onClick={() => document.getElementById('geometry-upload')?.click()}
                        variant="outline"
                        className="bg-zinc-900 border-zinc-800 text-zinc-300 hover:text-white"
                    >
                        <Plus size={14} className="mr-2" />
                        Agregar Forma
                    </Button>
                    <input
                        id="geometry-upload"
                        type="file"
                        accept="image/*"
                        className="hidden"
                        onChange={(e) => {
                            const file = e.target.files?.[0];
                            if (file) handleUpload(file, 'polygon');
                        }}
                    />
                </div>
            </div>

            {/* Generated image from AI */}
            {generatedImage && (
                <div className="mb-6 p-4 bg-amber-500/10 border border-amber-500/30 rounded-lg">
                    <div className="flex items-center gap-2 mb-2">
                        <Sparkles size={16} className="text-amber-500" />
                        <h4 className="text-amber-500 font-medium">Forma Generada por IA</h4>
                    </div>
                    <div className="bg-white rounded-lg p-4 flex items-center justify-center">
                        {/* eslint-disable-next-line @next/next/no-img-element */}
                        <img src={generatedImage} alt="Geometría generada por IA" className="max-w-full max-h-64 object-contain" />
                    </div>
                </div>
            )}

            <div className="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
                {items.map((item) => (
                    <div key={item.id} className="group relative bg-zinc-900 border border-zinc-800 rounded-lg p-4">
                        <div
                            className="aspect-square bg-zinc-950/50 rounded flex items-center justify-center"
                            style={{ backgroundColor: `${item.color}20` }}
                        >
                            {/* eslint-disable-next-line @next/next/no-img-element */}
                            <img src={item.url} alt={item.name} className="max-w-full max-h-full object-contain" />
                        </div>

                        <div className="space-y-2 mt-3">
                            <div className="flex items-center gap-2">
                                <span className="text-xs px-2 py-1 rounded bg-zinc-800 text-zinc-400 capitalize">
                                    {item.type}
                                </span>
                                <p className="text-sm font-medium text-zinc-300 truncate" title={item.name}>
                                    {item.name}
                                </p>
                            </div>
                            {item.color && (
                                <div className="flex items-center gap-2">
                                    <div
                                        className="w-4 h-4 rounded border border-zinc-700"
                                        style={{ backgroundColor: item.color }}
                                    />
                                    <span className="text-xs text-zinc-500">{item.color}</span>
                                </div>
                            )}
                        </div>

                        <button
                            onClick={() => onDelete(item.id)}
                            className="absolute top-2 right-2 opacity-0 group-hover:opacity-100 transition-opacity"
                        >
                            <Trash2 size={12} className="text-red-400 hover:text-red-300" />
                        </button>
                    </div>
                ))}
            </div>

            {items.length === 0 && (
                <div className="text-center py-12 text-zinc-500 border border-dashed border-zinc-800 rounded-lg">
                    <Square size={32} className="mx-auto mb-3 text-zinc-600" />
                    <p>No hay formas geométricas subidas todavía.</p>
                    <p className="text-sm mt-2">Agrega formas básicas de tu marca para comenzar.</p>
                </div>
            )}
        </div>
    );
};

const GeometryPatterns = ({ generatedText }: { generatedText?: string | null }) => {
    // Parse generated text for patterns if available
    const parseGeneratedPatterns = () => {
        if (!generatedText) return null;

        try {
            // Try to parse as JSON first
            const parsed = JSON.parse(generatedText);
            if (parsed.patterns && Array.isArray(parsed.patterns)) {
                return parsed.patterns;
            }
            if (parsed.base_shapes && Array.isArray(parsed.base_shapes)) {
                return parsed.base_shapes;
            }
        } catch {
            // Not JSON, try to extract patterns from text
            const patternsSection = generatedText.match(/patrones|patterns/i);
            if (patternsSection) return null;
        }

        return null;
    };

    const patterns = parseGeneratedPatterns();

    return (
    <div className="p-6 space-y-8">
        <div>
            <h3 className="text-lg font-medium text-white mb-4">Patrones y Texturas</h3>
            <p className="text-sm text-zinc-400 mb-6">
                Define los patrones visuales, texturas y elementos decorativos que complementan las formas geométricas de tu marca.
            </p>
        </div>

        {/* Generated content from AI */}
        {generatedText && (
            <div className="mb-6 p-4 bg-amber-500/10 border border-amber-500/30 rounded-lg">
                <div className="flex items-center gap-2 mb-3">
                    <Sparkles size={16} className="text-amber-500" />
                    <h4 className="text-amber-500 font-medium">Contenido Generado por IA</h4>
                </div>
                <div className="bg-zinc-900 rounded-lg p-4 text-sm text-zinc-300 whitespace-pre-wrap max-h-96 overflow-y-auto">
                    {generatedText}
                </div>
            </div>
        )}

        <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div className="bg-zinc-900 border border-zinc-800 rounded-lg p-6 space-y-4">
                <h4 className="text-white font-medium mb-3 flex items-center gap-2">
                    <Circle size={16} />
                    Patrones de Repetición
                </h4>
                <div className="space-y-3 text-sm text-zinc-400">
                    <p>• <span className="text-zinc-300">Diagonal Lines:</span> Líneas diagonales, rayas, puntos enrejados</p>
                    <p>• <span className="text-zinc-300">Grid:</span> Rejillas y mallas como estructura base</p>
                    <p>• <span className="text-zinc-300">Radial:</span> Patrones circulares concéntricos</p>
                    <p>• <span className="text-zinc-300">Orgánicos:</span> Formas fluidas inspiradas en naturaleza</p>
                </div>
            </div>

            <div className="bg-zinc-900 border border-zinc-800 rounded-lg p-6 space-y-4">
                <h4 className="text-white font-medium mb-3 flex items-center gap-2">
                    <Square size={16} />
                    Texturas y Fondos
                </h4>
                <div className="space-y-3 text-sm text-zinc-400">
                    <p>• <span className="text-zinc-300">Sólidos:</span> Colores planos sin degradado</p>
                    <p>• <span className="text-zinc-300">Degradados:</span> Transiciones suaves de color</p>
                    <p>• <span className="text-zinc-300">Texturizados:</span> Efectos de ruido, grano, papel</p>
                    <p>• <span className="text-zinc-300">Transparentes:</span> Uso de opacidad y transparencia</p>
                </div>
            </div>

            <div className="bg-zinc-900 border border-zinc-800 rounded-lg p-6 space-y-4">
                <h4 className="text-white font-medium mb-3 flex items-center gap-2">
                    <Triangle size={16} />
                    Motivos Visuales
                </h4>
                <div className="space-y-3 text-sm text-zinc-400">
                    <p>• <span className="text-zinc-300">Abstractos:</span> Formas no representacionales</p>
                    <p>• <span className="text-zinc-300">Geométricos:</span> Combinaciones de formas básicas</p>
                    <p>• <span className="text-zinc-300">Tipográficos:</span> Patrones con letras y números</p>
                    <p>• <span className="text-zinc-300">Naturales:</span> Elementos orgánicos estilizados</p>
                </div>
            </div>
        </div>
    </div>
);

