);

const GeometryExport = () => (
    <div className="p-6 space-y-6">
        <div>
            <h3 className="text-lg font-medium text-white mb-4">Exportar Assets</h3>
            <p className="text-sm text-zinc-400 mb-6">
                Descarga todos los assets geométricos en diferentes formatos para usar en tus diseños.
            </p>
        </div>

        <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
            <Button variant="outline" className="bg-zinc-900 border-zinc-800 text-zinc-300 h-full flex flex-col items-center justify-center gap-3 p-6 hover:text-white">
                <Download size={20} />
                <span className="font-medium">SVG</span>
                <span className="text-xs text-zinc-500">Vector escalable</span>
            </Button>

            <Button variant="outline" className="bg-zinc-900 border-zinc-800 text-zinc-300 h-full flex flex-col items-center justify-center gap-3 p-6 hover:text-white">
                <Download size={20} />
                <span className="font-medium">PNG</span>
                <span className="text-xs text-zinc-500">Raster con transparencia</span>
            </Button>

            <Button variant="outline" className="bg-zinc-900 border-zinc-800 text-zinc-300 h-full flex flex-col items-center justify-center gap-3 p-6 hover:text-white">
                <Download size={20} />
                <span className="font-medium">PDF</span>
                <span className="text-xs text-zinc-500">Guía de uso completa</span>
            </Button>
        </div>
    </div>
);

interface GeometryGeneratedContent {
    imageUrl?: string;
    text?: string;
    imagePrompt?: string;
    negativePrompt?: string;
}

interface WorkspaceContentProps {
    data: {
        content?: {
            items?: GeometryItem[];
        } | GeometryGeneratedContent;
    } | null;
    saveModule: (data: {
        content?: {
            items?: GeometryItem[];
        } | GeometryGeneratedContent;
    }) => void;
    brandId: string;
}

const WorkspaceContent = ({ data, saveModule, brandId }: WorkspaceContentProps) => {
    const [items, setItems] = useState<GeometryItem[]>([]);
    const [generatedImage, setGeneratedImage] = useState<string | null>(null);
    const [generatedText, setGeneratedText] = useState<string | null>(null);

    // Update state when data changes
    React.useEffect(() => {
        // Handle legacy format (items array)
        if (data?.content && typeof data.content === 'object' && 'items' in data.content) {
            setItems((data.content as { items?: GeometryItem[] }).items || []);
            setGeneratedImage(null);
            setGeneratedText(null);
        }
        // Handle new visual format (imageUrl + text)
        else if (data?.content && typeof data.content === 'object' && 'imageUrl' in data.content) {
            const visualContent = data.content as GeometryGeneratedContent;
            if (visualContent.imageUrl) {
                setGeneratedImage(visualContent.imageUrl);
            }
            if (visualContent.text) {
                setGeneratedText(visualContent.text);
            }
        }
    }, [data?.content]);

    // Save module when items change
    React.useEffect(() => {
        if (items.length > 0 && data) {
            saveModule({ ...data, content: { ...data?.content, items } });
        }
    }, [items, data, saveModule]);

    const handleAdd = (item: GeometryItem) => {
        const updated = [...items, item];
        setItems(updated);
    };

    const handleDelete = (id: string) => {
        const updated = items.filter(i => i.id !== id);
        setItems(updated);
    };

    return (
        <Tabs defaultValue="gallery" className="h-full flex flex-col">
            <div className="border-b border-zinc-800 px-6 bg-[#050505]">
                <TabsList className="bg-transparent h-12 p-0 gap-6">
                    <TabsTrigger value="gallery" className="data-[state=active]:bg-transparent data-[state=active]:border-b-2 data-[state=active]:border-amber-500 rounded-none h-full px-0 text-zinc-400 data-[state=active]:text-white">
                        <Shapes size={14} className="mr-2" /> Galería
                    </TabsTrigger>
                    <TabsTrigger value="patterns" className="data-[state=active]:bg-transparent data-[state=active]:border-b-2 data-[state=active]:border-amber-500 rounded-none h-full px-0 text-zinc-400 data-[state=active]:text-white">
                        <Maximize2 size={14} className="mr-2" /> Patrones
                    </TabsTrigger>
                    <TabsTrigger value="guidelines" className="data-[state=active]:bg-transparent data-[state=active]:border-b-2 data-[state=active]:border-amber-500 rounded-none h-full px-0 text-zinc-400 data-[state=active]:text-white">
                        <Circle size={14} className="mr-2" /> Guías
                    </TabsTrigger>
                    <TabsTrigger value="export" className="data-[state=active]:bg-transparent data-[state=active]:border-b-2 data-[state=active]:border-amber-500 rounded-none h-full px-0 text-zinc-400 data-[state=active]:text-white">
                        <Download size={14} className="mr-2" /> Exportar
                    </TabsTrigger>
                </TabsList>
            </div>

            <div className="flex-1 flex overflow-hidden">
                <div className="flex-1 bg-[#0A0A0A]">
                    <ScrollArea className="h-full">
                        <TabsContent value="gallery" className="m-0 focus:outline-none min-h-full">
                            <GeometryGallery
                                items={items}
                                onAdd={handleAdd}
                                onDelete={handleDelete}
                                brandId={brandId}
                                generatedImage={generatedImage}
                            />
                        </TabsContent>

                        <TabsContent value="patterns" className="m-0 focus:outline-none min-h-full">
                            <GeometryPatterns generatedText={generatedText} />
                        </TabsContent>

                        <TabsContent value="guidelines" className="m-0 focus:outline-none min-h-full">
                            <GeometryGuidelines />
                        </TabsContent>

                        <TabsContent value="export" className="m-0 focus:outline-none min-h-full">
                            <GeometryExport />
                        </TabsContent>
                    </ScrollArea>
                </div>
            </div>
        </Tabs>
    );
};

export default function GeometryWorkspace({ brandId }: { brandId: string }) {
    const [generationMode, setGenerationMode] = useState<GenerationMode>("questions");
    const [showAIPanel, setShowAIPanel] = useState(false);
    const [isGenerating, setIsGenerating] = useState(false);
    const [waitingProgress, setWaitingProgress] = useState(0);

    const handleGenerateAuto = async () => {
        setIsGenerating(true);
        setWaitingProgress(8);

        const interval = setInterval(() => {
            setWaitingProgress((prev) => {
                if (prev >= 92) return prev;
                return prev + 4;
            });
        }, 400);

        try {
            const response = await fetch("/api/generate", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    brandId,
                    moduleKey: "geometry",
                    mode: "auto",
                }),
            });

            if (!response.ok) {
                throw new Error("Error al generar contenido");
            }

            const reader = response.body?.getReader();
            const decoder = new TextDecoder();
            let resultContent: unknown = null;

            if (reader) {
                while (true) {
                    const { done, value } = await reader.read();
                    if (done) break;
                    
                    const chunk = decoder.decode(value);
                    const lines = chunk.split("\n");
                    
                    for (const line of lines) {
                        if (line.startsWith("data: ")) {
                            try {
                                const data = JSON.parse(line.slice(6));
                                if (data.type === "result" && data.success && data.data?.content) {
                                    resultContent = data.data.content;
                                } else if (data.type === "error") {
                                    throw new Error(data.error || "Error en generación");
                                }
                            } catch {
                                // Ignore parse errors for non-JSON lines
                            }
                        }
                    }
                }
            }

            if (!resultContent) {
                const data = await response.json();
                resultContent = data.content || data;
            }

            await fetch("/api/modules/save", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    brandId,
                    moduleKey: "geometry",
                    content: resultContent,
                    status: "completed",
                }),
            });

            if (typeof window !== "undefined") {
                window.dispatchEvent(
                    new CustomEvent("module-updated", {
                        detail: { brandId, moduleKey: "geometry" },
                    })
                );
            }

            toast.success("Formas geométricas generadas automáticamente");
        } catch (error) {
            console.error("Error generating geometry:", error);
            toast.error("Error al generar contenido con IA");
        } finally {
            clearInterval(interval);
            setIsGenerating(false);
            setWaitingProgress(0);
        }
    };

    const headerActions = (
        <div className="flex items-center gap-2">
            <Button
                variant="outline"
                size="sm"
                onClick={() => setGenerationMode(generationMode === "questions" ? "auto" : "questions")}
                className="h-9 bg-zinc-900 border-zinc-800 hover:bg-zinc-800 text-zinc-300 hover:text-white transition-colors"
            >
                <Wand2 size={14} className="mr-2" />
                {generationMode === "questions" ? "Modo: Con Preguntas" : "Modo: Automático"}
            </Button>
            {generationMode === "questions" ? (
                <Button
                    variant="outline"
                    size="sm"
                    onClick={() => setShowAIPanel(!showAIPanel)}
                    className="h-9 bg-zinc-900 border-zinc-800 hover:bg-zinc-800 text-zinc-300 hover:text-white transition-colors"
                >
                    <Sparkles size={14} className="mr-2" />
                    Generar con IA
                </Button>
            ) : (
                <Button
                    variant="outline"
                    size="sm"
                    onClick={handleGenerateAuto}
                    disabled={isGenerating}
                    className="h-9 bg-zinc-900 border-zinc-800 hover:bg-zinc-800 text-zinc-300 hover:text-white transition-colors"
                >
                    <Sparkles size={14} className="mr-2" />
                    {isGenerating ? "Generando..." : "Generar Automático"}
                </Button>
            )}
        </div>
    );

    return (
        <BaseWorkspace
            brandId={brandId}
            moduleKey="geometry"
            moduleName="Entidades Geométricas"
            moduleSubtitle="Formas, patrones y texturas de marca"
            backLink={`/dashboard/brands/${brandId}`}
            headerActions={headerActions}
        >
            {({ data, saveModule }) => (
                <>
                    {generationMode === "questions" && showAIPanel && (
                        <div className="border-b border-zinc-800 bg-[#050505] p-4">
                            <WorkspaceAIGenerator
                                moduleKey="geometry"
                                brandId={brandId}
                                externalExpanded={showAIPanel}
                                onGenerated={async (generatedData) => {
                                    const normalizedContent = generatedData && typeof generatedData === "object" && "content" in generatedData 
                                        ? (generatedData as { content: unknown }).content 
                                        : generatedData;
                                    
                                    await fetch("/api/modules/save", {
                                        method: "POST",
                                        headers: { "Content-Type": "application/json" },
                                        body: JSON.stringify({
                                            brandId,
                                            moduleKey: "geometry",
                                            content: normalizedContent,
                                            status: "completed",
                                        }),
                                    });

                                    if (typeof window !== "undefined") {
                                        window.dispatchEvent(
                                            new CustomEvent("module-updated", {
                                                detail: { brandId, moduleKey: "geometry" },
                                            })
                                        );
                                    }

                                    toast.success("Formas geométricas generadas");
                                    setShowAIPanel(false);
                                }}
                            />
                        </div>
                    )}
                    {generationMode === "auto" && isGenerating && (
                        <div className="border-b border-zinc-800 bg-[#050505] p-4">
                            <div className="space-y-2">
                                <div className="h-2 w-full rounded-full bg-zinc-800 overflow-hidden">
                                    <div
                                        className="h-full bg-amber-500 transition-all duration-300"
                                        style={{ width: `${waitingProgress}%` }}
                                    />
                                </div>
                                <p className="text-xs text-zinc-400">Generando formas geométricas automáticamente...</p>
                            </div>
                        </div>
                    )}
                    <WorkspaceContent data={data} saveModule={saveModule} brandId={brandId} />
                </>
            )}
        </BaseWorkspace>
    );
}
