# ============================================================================
# SUPABASE CONFIGURATION
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ============================================================================
# AI IMAGE GENERATION - Google Gemini (@google/genai)
# ============================================================================
# Required for visual modules image generation (logo, color palette, geometry,
# illustration, iconography, photography, qr codes)
GOOGLE_API_KEY=your_google_api_key_here
# Optional fallback variable name
# GEMINI_API_KEY=your_google_api_key_here
# Optional model override (default: gemini-3-pro-image-preview)
# GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
