# ============================================================================
# Supabase
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ============================================================================
# AI Text Generation (required for module generation)
# ============================================================================
OPENAI_API_KEY=your_openai_api_key
OPENAI_TEXT_MODEL=gpt-5-mini
AI_PROVIDER=openai

# ============================================================================
# AI Image Generation (optional for visual modules)
# ============================================================================
# Preferred provider in this setup:
GOOGLE_API_KEY=your_google_api_key_here
# Optional fallback variable name:
# GEMINI_API_KEY=your_google_api_key_here
# Optional model override:
# GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview

# ============================================================================
# Optional image provider alternatives (only if your deployment uses them)
# ============================================================================
# IMAGE_PROVIDER=deapi
# DEAPI_API_KEY=your_deapi_api_key
# DEAPI_API_URL=https://api.deapi.ai/api/v1/client/txt2img
